# Copy to .env and fill in real values. Never commit .env.
# Expo only inlines variables that start with EXPO_PUBLIC_.
# Restart Metro after changing this file: npm.cmd start -- --clear

EXPO_PUBLIC_OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_SITE_URL=https://github.com/your-org/Aura-AI-Mobile
EXPO_PUBLIC_OPENROUTER_APP_NAME=Aura AI Mobile

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_FIREBASE_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
